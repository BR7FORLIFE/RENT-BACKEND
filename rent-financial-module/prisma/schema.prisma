// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusContract{
  DRAFT // borrador (fase de creación de contrato) 
  PENDING // pendiente (el documento esta a la espera de firma)
  EXECUTION // ejecucion (el contrato sigue vigente y activo)
  DEFEATED // vencido (el contrato llega a su finalizacion)
}

enum TypeStreet{
  STREET // calle
  CAREER // carrera
  AVENUE // avenida
  DIAGONAL // diagonal
  CROSS // transversal
}

// tipos de precios o pagos de servicio por medio de acuerdos
enum PriceTypeAgreement{
  CUSTOM_QUOTE // precio de servicio personalizado
  FIXED // precio fijo de servicio
  NEGOTIABLE // precio de servicio negociable
  PERCENTAGE // precio de servicio acordado por partes, cuotas, etc..
}

enum Currency{
  COP
  USD
}

//estados de pago de dicho servicio (modelo ya que el encargado de esta logica es el modulo de pagos)
enum PaymentStatus{
  PENDING // pendiente
  COMPLETE // completo
  FAILED // fallido
  OPEN // orden creado por el cliente pero no se ha completado la transaccion
  AUTHORIZE // pago autorizado por el banco pero aun no se ha destinado al negocio o al receptor
  PAID // servicio pagado y depositado a la cuenta del receptor
  EXPIRED // el tiempo limite para el pago ha expirado
  REIMBURSED // pago reembolsado por cualquier problema o por parte del banco
}

// tipo de propiedad
model TypeProperty{
  id String @id
  name String @unique
  description String?

  properties Property[]
}

//estado de ocupacion del inmueble
model PropertyOccupationType{
  id String @id
  name String @unique
  description String?

  properties Property[]
}

//Tipo de acciones con su nombre y descripcion para mas auditoria de lo que hace
model PropertyActorRole{
  id String @id
  name String @unique
  description String?

  propertyMemberRoles PropertyMemberRole[]
}

//refleja el tipo de servicio publico dentro del inmueble
model PublicServiceType{
  id String @id @default(uuid())
  name String @unique
  description String?

  publicServices PublicService[]
}

//refleja la direccion de un inmueble
model Direction{
  id String @id @default(uuid())
  propertyId String @unique
  latitute Decimal
  longitud Decimal
  department String
  city String
  neighborhood String
  typeStreet TypeStreet @map("type_street")
  numberStreet Int @map("number_street")
  complement String?
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")

  property Property @relation(fields: [propertyId], references: [id])
}

//refleja recursos como imagenes, archivos, etc.
model ResourceImages{
  id String @id @default(uuid())
  assetId String? @map("asset_id")
  width Int? 
  height Int?
  format String?
  url String
  secureUrl String? @map("secure_url")
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")

  properties PropertyResources[]
  contracts ContractResources[]
}

/**
Propiedad ¿Que refleja?

Es la entidad principal del sistema refleja lo que es un inmueble y lo importante que es
ya que este nos permite registrar miembros activos dentro de esta, ademas de servicios, contratos
entre otra informacion importante

como tabla independiente o tabla de dominio fuerte todas sus relaciones parten de sus relaciones hijas
ya que este permite borrar todo lo correspondiente a esta.

¡ Desiciones de integridad !

- No debe tener dependencias hacia otras tablas debe ser entidad meramente fuerte
- Al ser borrada todas sus hijas deben ser borradas para mantener consistencia en la base de datos

**/
model Property{
  id String @id @default(uuid())
  userId String @map("user_id")
  registerByUserId String @map("register_by_userId")
  propertyTypeId String @map("property_type_id")
  propertyOccupationTypeId String @map("property_occupation_type_id")
  propertyName String @map("property_name")
  propertyDescription String @map("property_description")
  fmi String
  predialNumber String @map("predial_number")
  isPublished Boolean @map("is_published")
  
   // esto permite que los administradores validen la autenticidad del inmueble
  isActive Boolean @map("is_active") @default(false)
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")

  publicServices PublicService[]
  propertyMembers PropertyMember[]
  contracts Contract[]
  direction Direction?
  propertyResources PropertyResources[]
  typeProperty TypeProperty @relation(fields: [propertyTypeId], references: [id])
  propertyOccupationType PropertyOccupationType @relation(fields: [propertyOccupationTypeId], references: [id])
  economicPropertyInformation EconomicPropertyInformation?
  propertyStructureDescription PropertyStructureDescription?
}

//tabla intermedia para hacer la comunicacion N:M con resourcesImages
model PropertyResources{
  propertyId String @map("property_id")
  resourceId String @map("resource_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  resourcesImage ResourceImages @relation(fields: [resourceId], references: [id])

  @@id([propertyId, resourceId])
}

model EconomicPropertyInformation{
  id String @id @default(uuid())
  propertyId String @unique @map("property_id")
  monthlyRent Decimal @map("monthly_rent")
  depositAmount Decimal @map("deposit_amount") //cantidad de deposito (para daños o pagos de facturas)
  currency Currency 
  utilitiesIncluded Boolean @map("utilities_included") // si es servicios por aparte o vienen incluidos

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyStructureDescription {
  id String @id @default(uuid())
  propertyId String @unique @map("property_id")
  bedrooms Int // numero de habitaciones de la propiedad
  bathrooms Int //numero de baños de la propiedad
  floors Int //cantidad de pisos de la vivienda
  parkingSpaces Int //espacios de parqueo
  area Decimal // area total de la vivienda 
  lotArea Decimal // area total del lote donde esta construido la propiedad
  constructionYear Int? // año de contruccion de la vivienda

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/**
Contratos ¿Que refleja?  - Tabla muy dependiente a otras

refleja un acuerdo entre dos personas, para rentar un inmueble, donde se guarda
informacion relevante a dicho contrato, como el dinero de renta, las partes quienes 
lo firmaron, el estado de dicho contrato entre otra informacion relevante.

¡ Desiciones de integridad !

- NO se pueden crear nuevos contratos si es el estado del contrato es activo
- Hay relaciones bilaterales entre Arrendador y Arrendado. para mejor busqueda de informacion

**/
model Contract{
  id String @id @default(uuid())
  propertyId String @map("property_id")
  landlordMemberId String @map("landlord_member_id")
  tenantMemberId String @map("tenant_member_id")
  monthlyRent Decimal @map("monthly_rent")
  depositAmount Decimal @map("deposit_amount")
  startDate DateTime @map("start_date")
  endDate DateTime @map("end_date")
  status StatusContract
  createByUserId String @map("create_by_user_id")
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")
  

  contractResources ContractResources[]
  landlord PropertyMember @relation("LandlordContract", fields:[landlordMemberId],references:[id], onDelete: Cascade)
  tenant PropertyMember @relation("TenantContract", fields:[tenantMemberId], references:[id], onDelete: Cascade)
  property Property @relation(fields:[propertyId], references:[id], onDelete: Cascade)
}

model ContractResources {
  contractId String @map("contract_id")
  resourceId String @map("resource_id")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  resourcesImage ResourceImages @relation(fields: [resourceId], references: [id])

  @@id([contractId, resourceId])
}

/**
Miembros de la propidad ¿Que refleja?

Un miembro en la propiedad refleja aquellas personas vinculadas al inmueble y que persona fue
quien agregó dicho miembro, estos actores pueden tener multiples roles o servicios dentro de 
dicho inmueble permitiendo flexibilidad.

Ademas los miembros pueden ser ya sea Arrendados o Arrendadores vinculados a dichos contratos

¡ Desiciones de Integridad !

- Al borrar una propiedad sus miembros vinculadas a estas deben ser borrados
- Como es una tabla a la cual tiene relacion 1:N con roles estan tambien deben ser borradas para mantener
integridad referencial

**/
enum statusPropertyMember {
  ACTIVE //miembro activo con el inmueble y puede operar en ella
  DESACTIVE // no puede interactuar con el inmueble hasta que el propietario lo decida

  // en proceso de convertirse un miembro pero no cumple todos los requisitos antes de serlo
  // ṕor ejemplo -> ha aceptado la invitacion para unise a la vivienda pero el propietario no le
  // ha asignado sus roles
  IN_PROCESS 
}

model PropertyMember{
  id String @id @default(uuid())
  userId String @map("user_id")
  propertyId String @map("property_id")
  status statusPropertyMember
  assignedBy String @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  updateAt DateTime @updatedAt @map("update_at")

  @@unique([userId, propertyId])

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyMemberRole PropertyMemberRole[]
  propertyServiceAssignment PropertyServiceAssignment[]
  landlordContracts Contract[] @relation("LandlordContract")
  tenantContracts Contract[] @relation("TenantContract")
}

//refleja una tabla intermedia con su respectiva accion dentro del inmueble
model PropertyMemberRole{
  id String @id @default(uuid())
  propertyMemberId String @map("property_member_id")
  propertyActorRoleId String @map("property_actor_role_id")

  @@unique([propertyActorRoleId, propertyMemberId])

  propertyMember PropertyMember @relation(fields: [propertyMemberId], references: [id], onDelete: Cascade)
  propertyActorRole PropertyActorRole @relation(fields: [propertyActorRoleId], references: [id])
}

//ref
model Service{
  id String @id @default(uuid())
  name String 
  description String

  propertyServiceAssignments PropertyServiceAssignment[]
}

/**
Asignamiento de servicios a propiedades ¿Que refleja?

Refleja los servicios que prestan los miembros en las distintas propiedades
ya que una propiedad pueden tener diferentes acciones dentro de la misma, ya sea de abogacia, 
administracion, etc etc.

¡ Desiciones de integridad !

- Vincular el servicio unicamente al miembro activo de la propiedad
esto permite ganar consistencia ya que el servicio esta vinculado 
al inmueble y no directamente al inmueble

- Un miembro activo en el inmueble puede prestar muchos servicio a la misma propiedad
**/
model PropertyServiceAssignment{
  id String @id @default(uuid())
  propertyMemberId String @map("property_member_id")
  serviceId String @map("service_id")
  priceTypeAgreement PriceTypeAgreement @map("price_type_agreement")
  basePrice Decimal @map("base_price")
  currency Currency
  expirationDate DateTime @map("expiration_date")
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")
  paymentStatus PaymentStatus @map("payment_status")

  propertyMember PropertyMember @relation(fields: [propertyMemberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}

/**
Servicios publicos ¿Que refleja?

refleja los servicios publicos de una vivienda, donde sus unicas relaciones correspondientes
son con las propiedades ya que estas cuentan con distintos servicios publicos y ademas esta
enlazada con una tabla logica (lookup Table) que refleja el tipo de servicio publico.

¡ Desiciones de Integridad !

- al borrar una propiedad sus vinculaciones deben ser borradas en este caso el servicio o los servicios
publicos vinculados al inmueble

**/
model PublicService{
  id String @id @default(uuid())
  propertyId String @map("property_id")
  publicServiceTypeId String @map("public_service_type_id")
  accountNumber String @map("account_number")
  registerDate DateTime @default(now()) @map("register_date")
  updateAt DateTime @updatedAt @map("update_at")

  publicServiceType PublicServiceType @relation(fields:[publicServiceTypeId], references:[id])
  property Property @relation(fields:[propertyId], references:[id], onDelete: Cascade)
  @@unique([propertyId, publicServiceTypeId])
}

//invitation linked
enum StatusInvitationLinked{
  REVOCKED // invitaciones revocadas
  CONSUMED // enlaces de invitacion consumidas o utilizadas
  EXPIRED // enlaces de invitacion en tiempo expiradas
  DRAFT //recien creada a la espera de un estado
}

model InvitationLinked{
  id String @id @default(uuid())
  propertyId String @map("property_id") //hacia que propiedad es la invitacion
  invitedBy String @map("invited_by")
  invitedUserId String @map("invited_user_id") //id del usuario activo para la persona invitada
  invitedEmailTo String @map("invited_email_to")
  token String 
  status StatusInvitationLinked @default(DRAFT)
  expirationTime DateTime @map("expiration_time")
  createAt DateTime @default(now()) @map("create_at")
  updateAt DateTime @updatedAt @map("update_at")
}